# FunnyMoneyHoney environment — copy to .env and fill in values.
# Never commit a real .env file.

# Force demo/offline sample odds (recommended for first run)
DEMO_MODE=true

# Optional: The Odds API key for live public odds
# Get a key at https://the-odds-api.com/ (free tier available)
ODDS_API_KEY=

# SQLite by default; use PostgreSQL in production if desired
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/funnymoneyhoney
DATABASE_URL=sqlite:///./funnymoneyhoney.db

# Comma-separated browser origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Feed refresh hint (seconds) returned to the UI
REFRESH_SECONDS=30

# Default stake used by simulator docs / defaults
DEFAULT_DAILY_STAKE=1000
